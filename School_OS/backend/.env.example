# =============================================================================
# School OS — Environment Variables
# Copy to .env and fill in production values
# =============================================================================

# --- Django Core ---
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=0
DJANGO_SETTINGS_MODULE=config.settings
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://user:password@localhost:5432/schoolos
DB_NAME=schoolos
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432

# --- Cache ---
REDIS_URL=redis://redis:6379/0

# --- AWS S3 / Media Storage ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=eu-west-1
AWS_S3_ENDPOINT_URL=

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://admin.your-domain.com,https://www.your-domain.com

# --- JWT ---
SIMPLE_JWT_ACCESS_TOKEN_LIFETIME=30
SIMPLE_JWT_REFRESH_TOKEN_LIFETIME=1440

# --- Email (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# --- Portal URLs ---
ADMIN_PORTAL_URL=https://admin.your-domain.com
PARENT_PORTAL_URL=https://parents.your-domain.com
TEACHER_PORTAL_URL=https://teachers.your-domain.com
BURSAR_PORTAL_URL=https://bursar.your-domain.com

# --- Gov Portal (Cameroon-specific) ---
GOV_API_SECRET=
FONERA_STUDENT_ID_PREFIX=CM-
GOV_MINISTRY_ENDPOINT=https://api.education.cm/v1
GOV_ENCRYPTION_KEY=
